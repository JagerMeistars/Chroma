{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "fixed",
          "none"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "chroma:custom/marker_dome",
          "tints": [
            {
              "type": "minecraft:custom_model_data",
              "index": 0,
              "default": -1
            }
          ]
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/paper"
    }
  }
}
